{
  "name": "screenlink-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/fetch-sidecars.mjs",
    "brand": "tauri icon src-tauri/icons/source.png && node scripts/generate-brand.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
